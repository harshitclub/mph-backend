# ==============================================
# APPLICATION CORE
# ==============================================
ENV="development"
PORT=3002
FRONTEND_URL="http://localhost:3000"
LOG_LEVEL="info"

# ==============================================
# DATABASE (PostgreSQL)
# ==============================================
DATABASE_URL="postgres_connection_string"

# ==============================================
# REDIS & QUEUES
# ==============================================
# Primary Cache (Upstash)
REDIS_CACHE_URL="redis_cache_connection_string"

# Job Queue (BullMQ - Local/Docker)
REDIS_BULL_URL="redis://localhost:6380"
EMAIL_WORKER_CONCURRENCY=5

# ==============================================
# AUTHENTICATION & SECURITY
# ==============================================
BCRYPT_SALT_ROUNDS=10
MAX_FAILED_LOGIN=10

# JWT Secrets
JWT_ACCESS_SECRET="access_secret"
JWT_REFRESH_SECRET="refresh_secret"
JWT_VERIFICATION_SECRET="verification_secret"

# ==============================================
# COOKIE CONFIGURATION
# ==============================================
REFRESH_COOKIE_NAME="mph_refresh_token"
REFRESH_COOKIE_PATH="/"
REFRESH_TOKEN_TTL_SECONDS=604800 # 7 Days

# ==============================================
# EMAIL SERVICE (SMTP)
# ==============================================
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="mail"
SMTP_PASS="mail_password"
MAIL_FROM="MPH <mail>"

# ==============================================
# SYSTEM ADMIN
# ==============================================
ADMIN_CREATION_SECRET="admin_creation_secret"